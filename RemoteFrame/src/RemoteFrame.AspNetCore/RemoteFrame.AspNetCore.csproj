<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>RemoteFrame.AspNetCore</PackageId>
    <Description>Authenticated server-side file rendering endpoints, embedded browser viewer and session management for ASP.NET Core.</Description>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../RemoteFrame.Core/RemoteFrame.Core.csproj" />
    <ProjectReference Include="../RemoteFrame.Rendering/RemoteFrame.Rendering.csproj" />
    <None Include="PACKAGE.md" Pack="true" PackagePath="/" />
    <EmbeddedResource Include="Viewer/*" LogicalName="RemoteFrame.Viewer.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>


