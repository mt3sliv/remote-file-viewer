<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseRemoteFramePackages Condition="'$(UseRemoteFramePackages)' == ''">true</UseRemoteFramePackages>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../RemoteFrame.AspNetCore/RemoteFrame.AspNetCore.csproj" Condition="'$(UseRemoteFramePackages)' != 'true'" />
        <PackageReference Include="RemoteFrame.Office.Windows.WithLibreOffice" Version="$(RemoteFramePackageVersion)" Condition="'$(UseRemoteFramePackages)' == 'true'" />

		<Content Include="../../samples/**/*" Link="samples/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	<Target Name="VerifyRemoteFrameDemoRuntime" AfterTargets="Build"
		Condition="'$(UseRemoteFramePackages)' == 'true' and '$(DesignTimeBuild)' != 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
		<Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tests/TestDemoRuntime.ps1&quot; -ServerOutputDirectory &quot;$(TargetDir).&quot; -ExpectedPackageVersion &quot;$(RemoteFramePackageVersion)&quot; -UsePackageWorker" />
	</Target>
</Project>
