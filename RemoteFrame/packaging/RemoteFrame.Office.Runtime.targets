<Project>
  <!-- Preserve each complete native component tree, including engine and worker resources. -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)../tools/remote-frame/**/*">
      <Link>remote-frame/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Visible>false</Visible>
      <Pack>false</Pack>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
